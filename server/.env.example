# ========================================================
# KirayaSetu Server & MySQL Database Configuration (Example)
# ========================================================

PORT=5000

# Option 1: Local MySQL
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=kirayasetu_db

# Option 2: Aiven Cloud MySQL (For Render Deployment)
# MYSQL_HOST=mysql-xxxx-project.aivencloud.com
# MYSQL_PORT=12345
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your_aiven_password
# MYSQL_DATABASE=defaultdb
# MYSQL_SSL=true

# Or single Service URI from Aiven:
# DATABASE_URL=mysql://avnadmin:password@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

